rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // --- ENTITY VALIDATIONS ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'displayName', 'verificationStatus', 'createdAt'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 100
        && data.role in ['worker', 'company', 'individual']
        && data.displayName is string && data.displayName.size() <= 50
        && data.verificationStatus in ['none', 'unverified']
        && (data.trustScore == null || data.trustScore == 0)
        && data.createdAt == request.time;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['title', 'description', 'postedBy', 'status', 'createdAt'])
        && data.title is string && data.title.size() <= 100
        && data.description is string && data.description.size() <= 2000
        && data.postedBy == request.auth.uid
        && data.status in ['open', 'closed', 'filled']
        && data.createdAt == request.time;
    }

    // --- COLLECTIONS ---

    // USERS
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        // Action: Update Profile
        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'location', 'photoURL']))
        || isAdmin()
      );
    }

    // JOBS
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidJob(incoming());
      allow update: if isSignedIn() && (
        isOwner(existing().postedBy) && (
          // Action: Edit metadata
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'salary', 'location', 'deadline', 'status'])
        )
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // WALLETS (PII / High Security)
    match /wallets/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && incoming().balance == 0 && incoming().escrow == 0;
      allow update: if isAdmin(); // Only system/admin can move money in this MVP
    }

    // VERIFICATION REQUESTS
    match /verificationRequests/{requestId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin();
    }
    
    // ADMINS (Bootstrap)
    match /admins/{userId} {
      allow read: if isSignedIn();
      // Only via internal cloud console initially
    }
  }
}

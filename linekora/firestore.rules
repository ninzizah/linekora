rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'displayName', 'verificationStatus', 'createdAt'])
        && data.uid == request.auth.uid
        && data.role in ['worker', 'company', 'individual']
        && data.verificationStatus in ['none', 'unverified']
        && data.createdAt == request.time;
    }

    function isValidJob(data) {
      return data.keys().hasAll(['title', 'description', 'postedBy', 'status', 'createdAt'])
        && data.postedBy == request.auth.uid
        && data.status in ['open', 'closed', 'filled']
        && data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'location', 'photoURL', 'bio'])
        || isAdmin()
      );
    }

    match /workerProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidJob(incoming());
      allow update: if (isOwner(existing().postedBy) || isAdmin());
    }

    match /applications/{appId} {
      allow read: if isSignedIn() && (isOwner(resource.data.workerId) || isOwner(get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.postedBy));
      allow create: if isVerified() && incoming().workerId == request.auth.uid;
      allow update: if isAdmin() || isOwner(get(/databases/$(database)/documents/jobs/$(existing().jobId)).data.postedBy);
    }

    match /wallets/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && incoming().balance == 0;
      allow update: if isAdmin();
    }

    match /verificationRequests/{requestId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if isSignedIn();
    }
  }
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String   @id @default(uuid())
  firebaseUid        String   @unique
  email              String   @unique
  displayName        String
  role               Role     @default(WORKER)
  phone              String?
  location           String?
  avatarUrl          String?  @db.Text
  trustScore         Int      @default(50)
  tier               String   @default("Free Account")
  verificationStatus String   @default("unverified")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Verification documents (stored server-side for admin review)
  verificationData   String?  @db.Text  // JSON: { nationalId, frontId, backId, selfie, tinNumber, certFile, sector, cell, address, website, selectedTier, date }

  jobsPosted      Job[]         @relation("EmployerJobs")
  applications    Application[]
  reviewsReceived Review[]      @relation("ReviewReceiver")
  reviewsGiven    Review[]      @relation("ReviewGiver")
  messagesSent    Message[]     @relation("MessageSender")
  messagesReceived Message[]    @relation("MessageReceiver")
  notifications   Notification[]
  teamMemberships TeamMembership[]
}

model Team {
  id          String   @id @default(uuid())
  teamCode    String   @unique
  name        String
  email       String?
  phone       String?
  mainSkill   String?
  location    String?
  description String?  @db.Text
  logoUrl     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   TeamMembership[]
  invitations   TeamInvitation[]
  announcements TeamAnnouncement[]
  applications  Application[]
}

model TeamMembership {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  role      String   @default("member") // super_leader, senior_leader, assistant_leader, member
  joinedAt  DateTime @default(now())

  @@unique([userId, teamId])
}

model TeamInvitation {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  email     String
  phone     String?
  role      String   @default("member") // senior_leader, assistant_leader, member
  status    String   @default("pending") // pending, accepted, declined
  invitedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamAnnouncement {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  title     String
  body      String   @db.Text
  authorId  String
  createdAt DateTime @default(now())
}

model Job {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  salary      String
  location    String
  category    String?
  urgent      Boolean   @default(false)
  status      String    @default("open") // open, accepted, completion_requested, completed, expired
  deadline    DateTime?
  phone       String?
  jobType     String?   @default("on-demand") // full-time, part-time, contract, on-demand
  requirements String?
  photos      String?   @db.Text // JSON array of base64 data URLs
  workerType  String?   @default("individual") // individual, team, both
  employerId  String
  employer    User      @relation("EmployerJobs", fields: [employerId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]
}

model Application {
  id              Int      @id @default(autoincrement())
  jobId           Int
  job             Job      @relation(fields: [jobId], references: [id])
  workerId        String
  worker          User     @relation(fields: [workerId], references: [id])
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])
  applyType       String   @default("individual") // individual, team
  status          String   @default("pending") // pending, accepted, rejected
  assignedMembers String?  @db.Text  // JSON array of userIds assigned by leader
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([jobId, workerId])
}

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  comment    String?
  reviewerId String
  reviewer   User     @relation("ReviewGiver", fields: [reviewerId], references: [id])
  targetId   String
  target     User     @relation("ReviewReceiver", fields: [targetId], references: [id])
  createdAt  DateTime @default(now())
}

model Message {
  id         Int      @id @default(autoincrement())
  content    String
  read       Boolean  @default(false)
  senderId   String
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("MessageReceiver", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String   @default("info") // info, success, urgent, warning
  link      String?  // client-side route to navigate to when clicked (e.g. "/dashboard/worker/applications")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum Role {
  WORKER
  COMPANY
  EMPLOYER
  ADMIN
}

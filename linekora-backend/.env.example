DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
PORT=5000
# Firebase project ID — used to verify client ID tokens (defaults to linekora-7dd3e)
FIREBASE_PROJECT_ID="linekora-7dd3e"
# Admin portal shortcut credentials (defaults to Ndive Labs / Ndive-admin@12345)
# ADMIN_USERNAME="Ndive Labs"
# ADMIN_PASSKEY="Ndive-admin@12345"
# Secret that signs the standalone admin operator tokens — CHANGE THIS in production
# OPERATOR_SECRET="change-me-to-a-long-random-string"
